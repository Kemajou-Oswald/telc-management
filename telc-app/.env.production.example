APP_NAME="TELC Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Africa/Douala

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telc_app
DB_USERNAME=telc_user
DB_PASSWORD=change_me

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60
EXPORT_MAX_ROWS=2000
WHATSAPP_TIMEOUT=10
WHATSAPP_CONNECT_TIMEOUT=5

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

WHATSAPP_PROVIDER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_BASE_URL=https://api.twilio.com/2010-04-01

SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_PHONE=
SEED_SUPER_ADMIN_2_NAME=
SEED_SUPER_ADMIN_2_EMAIL=
SEED_SUPER_ADMIN_2_PASSWORD=
SEED_SUPER_ADMIN_2_PHONE=

SEED_DEMO_USERS=false
SEED_DEMO_USERS_PASSWORD=ChangeMeBeforeProd123!
